// RV328 chip top level for GF180MCU (wafer.space half-height slot, 72 pads).
// GENERATED by scripts/gen_padring.py from scripts/chip_top.v.in - edit those.
//
// Die pads and package pins are not the same thing: pins that carry both a
// digital and an analog function have two die pads (a bi_24t and an asig_5p0)
// bonded to the same lead, and the serial-memory, JTAG and spare pads are not
// bonded out of the 32-pin package at all. See docs/bondout.md.
`default_nettype none
module chip_top (
`ifdef USE_POWER_PINS
	inout  wire VDD,
	inout  wire VSS,
	inout  wire DVDD,
	inout  wire DVSS,
`endif
	inout  wire [7:0] PB,
	inout  wire [6:0] PC,
	inout  wire [7:0] PD,
	inout  wire [3:0] PE,
	// analog taps (second die pad on the same package pin) and analog-only pins
	inout  wire       A_XTAL1, A_XTAL2, A_AREF, A_AVCC, A_AIN0, A_AIN1,
	inout  wire       A_ADC0, A_ADC1, A_ADC2, A_ADC3, A_ADC4, A_ADC5, A_ADC6, A_ADC7,
	// in-package serial memory
	inout  wire       FL_CSN, FL_SCK, FL_MOSI, FL_MISO,
	// test pads
	inout  wire       TCK, TMS, TDI, TDO,
	inout  wire [6:0] SPARE
);
`ifdef USE_POWER_PINS
	// the foundry I/O cells share one supply between pad ring and core
	assign VDD = DVDD;
	assign VSS = DVSS;
`endif

	wire [31:0] pad_in, pad_out, pad_oe, pad_pu, pad_ie;
	wire        core_fl_csn, core_fl_sck, core_fl_mosi, core_fl_miso;
	wire        jtag_tck, jtag_tms, jtag_tdi, jtag_tdo;

	// unimplemented port bits
	assign pad_in[15]    = 1'b0;
	assign pad_in[31:28] = 4'h0;

	// Core side of the pad signals. With RV328_PADBUF every pad signal has a buffer of its own,
	// which the floorplan places beside its pad; without it the two sides are the same nets.
	wire [31:0] c_in, c_out, c_oe, c_pu, c_ie;
	wire        p_fl_csn, p_fl_sck, p_fl_mosi, p_fl_miso;
`ifdef RV328_PADBUF
@PADBUFS@
`else
	assign c_in = pad_in;
	assign pad_out = c_out;
	assign pad_oe = c_oe;
	assign pad_pu = c_pu;
	assign pad_ie = c_ie;
	assign p_fl_csn = core_fl_csn;
	assign p_fl_sck = core_fl_sck;
	assign p_fl_mosi = core_fl_mosi;
	assign core_fl_miso = p_fl_miso;
`endif

	// ---------------- power pads ----------------
	genvar i;
	generate
	for (i = 0; i < 7; i = i + 1) begin : dvdd_pads
		(* keep *) gf180mcu_fd_io__dvdd pad (
`ifdef USE_POWER_PINS
			.DVDD (DVDD), .DVSS (DVSS), .VDD (VDD), .VSS (VSS)
`endif
		);
	end
	for (i = 0; i < 7; i = i + 1) begin : dvss_pads
		(* keep *) gf180mcu_fd_io__dvss pad (
`ifdef USE_POWER_PINS
			.DVDD (DVDD), .DVSS (DVSS), .VDD (VDD), .VSS (VSS)
`endif
		);
	end
	for (i = 0; i < 1; i = i + 1) begin : vdd_pads
		(* keep *) gf180mcu_fd_io__dvdd pad (
`ifdef USE_POWER_PINS
			.DVDD (DVDD), .DVSS (DVSS), .VDD (VDD), .VSS (VSS)
`endif
		);
	end
	for (i = 0; i < 1; i = i + 1) begin : vss_pads
		(* keep *) gf180mcu_fd_io__dvss pad (
`ifdef USE_POWER_PINS
			.DVDD (DVDD), .DVSS (DVSS), .VDD (VDD), .VSS (VSS)
`endif
		);
	end
	endgenerate

	// ---------------- signal pads ----------------
@PADS@

	// ---------------- analog ----------------
	wire        clk_rc, clk_xa, clk_lf, por_n, bod, rc_en, xo_en, bod_en;
	wire [7:0]  rc_trim;
	wire [1:0]  xo_mode, adc_refs;
	wire [2:0]  bod_level;
	wire        adc_en, adc_sample, adc_cmp, ac_en, ac_bg, ac_mux_en, ac_out;
	wire [3:0]  adc_mux;
	wire [9:0]  adc_dac;

`ifdef RV328_ANALOG_MACRO
	// the analog macro itself (flow/librelane/ip/rv328_analog, from scripts/gen_analog_abstract.py): its pins
	// carry the layout's own names, buses split into bits; its ground pin vss is joined by the power grid
	(* keep *) rv328_analog u_analog (
		.xtal1 (A_XTAL1), .xtal2 (A_XTAL2), .aref (A_AREF), .avdd (A_AVCC), .adc0 (A_ADC0), .adc1 (A_ADC1),
		.adc2 (A_ADC2), .adc3 (A_ADC3), .adc4 (A_ADC4), .adc5 (A_ADC5), .adc6 (A_ADC6), .adc7 (A_ADC7),
		.ain0 (A_AIN0), .ain1 (A_AIN1), .clk_rc (clk_rc), .clk_xa (clk_xa), .clk_lf (clk_lf), .por_n (por_n),
		.rc_en (rc_en), .xo_en (xo_en), .bod_en (bod_en), .adc_en (adc_en), .adc_sample (adc_sample),
		.adc_cmp (adc_cmp), .ac_en (ac_en), .ac_bg (ac_bg), .ac_mux_en (ac_mux_en), .ac_out (ac_out), .bod_o (bod),
		.rc_trim0 (rc_trim[0]), .rc_trim1 (rc_trim[1]), .rc_trim2 (rc_trim[2]), .rc_trim3 (rc_trim[3]),
		.rc_trim4 (rc_trim[4]), .rc_trim5 (rc_trim[5]), .rc_trim6 (rc_trim[6]), .rc_trim7 (rc_trim[7]),
		.xo_mode0 (xo_mode[0]), .xo_mode1 (xo_mode[1]), .bod_level0 (bod_level[0]), .bod_level1 (bod_level[1]),
		.bod_level2 (bod_level[2]), .adc_mux0 (adc_mux[0]), .adc_mux1 (adc_mux[1]), .adc_mux2 (adc_mux[2]),
		.adc_mux3 (adc_mux[3]), .adc_refs0 (adc_refs[0]), .adc_refs1 (adc_refs[1]), .adc_dac0 (adc_dac[0]),
		.adc_dac1 (adc_dac[1]), .adc_dac2 (adc_dac[2]), .adc_dac3 (adc_dac[3]), .adc_dac4 (adc_dac[4]),
		.adc_dac5 (adc_dac[5]), .adc_dac6 (adc_dac[6]), .adc_dac7 (adc_dac[7]), .adc_dac8 (adc_dac[8]),
		.adc_dac9 (adc_dac[9])
	);
`else
	(* keep *) rv328_analog u_analog (
		.XTAL1 (A_XTAL1), .XTAL2 (A_XTAL2), .AREF (A_AREF), .AVCC (A_AVCC),
		.ADC ({A_ADC7, A_ADC6, A_ADC5, A_ADC4, A_ADC3, A_ADC2, A_ADC1, A_ADC0}),
		.AIN0 (A_AIN0), .AIN1 (A_AIN1),
		.dig_clk_i (pad_in[6]), .dig_rstn_i (pad_in[14]),
		.clk_rc (clk_rc), .clk_xa (clk_xa), .clk_lf (clk_lf), .por_n (por_n), .bod_o (bod),
		.rc_en (rc_en), .rc_trim (rc_trim), .xo_en (xo_en), .xo_mode (xo_mode),
		.bod_en (bod_en), .bod_level (bod_level),
		.adc_en (adc_en), .adc_mux (adc_mux), .adc_refs (adc_refs), .adc_sample (adc_sample),
		.adc_dac (adc_dac), .adc_cmp (adc_cmp),
		.ac_en (ac_en), .ac_bg (ac_bg), .ac_mux_en (ac_mux_en), .ac_out (ac_out)
	);
`endif

	// ---------------- digital core ----------------
	rv328_core u_core (
		.clk_rc (clk_rc), .clk_xa (clk_xa), .clk_lf (clk_lf), .por_n (por_n), .bod_i (bod),
		.rc_en (rc_en), .rc_trim (rc_trim), .xo_en (xo_en), .xo_mode (xo_mode),
		.bod_en (bod_en), .bod_level (bod_level),
		.adc_en (adc_en), .adc_mux (adc_mux), .adc_refs (adc_refs), .adc_sample (adc_sample),
		.adc_dac (adc_dac), .adc_cmp (adc_cmp),
		.ac_en (ac_en), .ac_bg (ac_bg), .ac_mux_en (ac_mux_en), .ac_out (ac_out),
		.pad_in (c_in), .pad_out (c_out), .pad_oe (c_oe), .pad_pu (c_pu), .pad_ie (c_ie),
		.fl_csn (core_fl_csn), .fl_sck (core_fl_sck), .fl_mosi (core_fl_mosi), .fl_miso (core_fl_miso),
		.jtag_tck (jtag_tck), .jtag_tms (jtag_tms), .jtag_tdi (jtag_tdi), .jtag_tdo (jtag_tdo)
	);

`ifdef RV328_WAFERSPACE_IDS
	// wafer.space identification macros: required for submission
	(* keep *) gf180mcu_ws_ip__qrcode_id  qrcode_id ();
	(* keep *) gf180mcu_ws_ip__shuttle_id shuttle_id ();
	(* keep *) gf180mcu_ws_ip__project_id project_id ();
	(* keep *) gf180mcu_ws_ip__marker     marker ();
`endif
`ifdef RV328_ANALOG_BLANK
	// trial floorplans only: a block of the analog macro's size, without pins (scripts/gen_analog_blank.py)
	(* keep *) rv328_analog_blank u_analog_blank ();
`endif
endmodule
`default_nettype wire
